{
  "name": "hail-guard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node src/cli/check.ts",
    "backtest": "node src/cli/backtest.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "calibrate": "node src/cli/calibrate.ts",
    "log-forecast": "node src/cli/log-forecast.ts",
    "serve": "npm run build && node src/server.ts",
    "build": "esbuild src/browser.ts --bundle --format=esm --target=es2020 --minify --sourcemap --outfile=public/engine.js",
    "build:site": "npm run build && node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
